/**
 * Adds a compact navigation row to every correction-tools page.
 */
function ci_correction_rules_page_alter(&$page) {
  if (strpos(current_path(), 'correction-tools') !== 0) {
    return;
  }

  $links = array(
    l(t('Overview'), 'corrections'),
    l(t('Rules'), 'correction-tools/rules'),
    l(t('Review corrections'), 'correction-tools/review'),
    l(t('Correction history'), 'correction-tools/history'),
    l(t('CI Network Correction Suggestions'), 'correction-tools/concordance'),
    l(t('Update network statistics'), 'correction-tools/network-update'),
  );

  if (isset($page['content']) && is_array($page['content'])) {
    $page['content']['ci_correction_rules_navigation'] = array(
      '#markup' => '<nav class="correction-tools-navigation">' . implode(' | ', $links) . '</nav>',
      '#weight' => -100,
    );
  }
}

/**
 * Implements hook_node_access().
 */
function ci_correction_rules_node_access($node, $op, $account) {
  $is_rule = (is_string($node) && $node === 'ci_correction_rule')
    || (is_object($node) && isset($node->type) && $node->type === 'ci_correction_rule');
  if ($is_rule && in_array($op, array('create', 'update', 'delete'), TRUE)) {
    return ci_correction_rules_manage_access($account) ? NODE_ACCESS_ALLOW : NODE_ACCESS_DENY;
  }
}

/**
 * Checks access for correction-rule node edit and delete forms.
 */
function ci_correction_rules_node_operation_access($op, $node) {
  return is_object($node)
    && isset($node->type)
    && $node->type === 'ci_correction_rule'
    && ci_correction_rules_manage_access()
    && node_access($op, $node);
}

/**
 * Landing page listing correction totals and all correction tools.
 */
function ci_correction_rules_landing_page() {
  $rule_total = (int) db_query(
    "SELECT COUNT(*) FROM {node} WHERE type = :type",
    array(':type' => 'ci_correction_rule')
  )->fetchField();
  $applied_rule_total = 0;
  $changed_chant_total = 0;

  if (db_table_exists('aa_corrections') && db_field_exists('aa_corrections', 'rule_nid') && db_field_exists('aa_corrections', 'applied')) {
    $applied_rule_total = (int) db_query(
      "SELECT COUNT(DISTINCT c.rule_nid)\n       FROM {aa_corrections} c\n       INNER JOIN {node} r ON r.nid = c.rule_nid\n       WHERE c.applied = 1 AND r.type = :type",
      array(':type' => 'ci_correction_rule')
    )->fetchField();
  }
  if (db_table_exists('aa_corrections') && db_field_exists('aa_corrections', 'applied')) {
    $changed_chant_total = (int) db_query(
      "SELECT COUNT(DISTINCT c.nid)\n       FROM {aa_corrections} c\n       INNER JOIN {node} n ON n.nid = c.nid\n       WHERE c.applied = 1 AND n.type = :type",
      array(':type' => 'master_chant')
    )->fetchField();
  }

  $links = array(
    '<strong>' . l(t('Review and apply next rule'), 'correction-tools/review') . '</strong>',
    l(t('All correction rules'), 'correction-tools/rules'),
    l(t('Correction history'), 'correction-tools/history'),
    l(t('CI Network Correction Suggestions'), 'correction-tools/concordance'),
    l(t('Update correction network statistics'), 'correction-tools/network-update'),
  );

  $build['intro'] = array(
    '#markup' => '<p>' . t('Manage spelling corrections for Cantus Index chants and review related concordance data.') . '</p>',
  );
  $build['statistics'] = array(
    '#theme' => 'table',
    '#header' => array(t('All rules'), t('Rules applied'), t('Master Chants changed')),
    '#rows' => array(array($rule_total, $applied_rule_total, $changed_chant_total)),
    '#attributes' => array('class' => array('cantus-corrections-overview')),
  );
  $build['tools'] = array(
    '#theme' => 'item_list',
    '#title' => t('Correction tools'),
    '#items' => $links,
  );
  return $build;
}

/**
 * Implements hook_node_presave().
 */
function ci_correction_rules_node_presave($node) {
  if ($node->type !== 'ci_correction_rule') {
    return;
  }

  $find_items = field_get_items('node', $node, 'field_ci_rule_find');
  $replace_items = field_get_items('node', $node, 'field_ci_rule_replace');
  $find = $find_items ? $find_items[0]['value'] : '';
  $replace = $replace_items ? $replace_items[0]['value'] : '';

  $node->title = truncate_utf8($find . ' → ' . $replace, 255, FALSE, TRUE);
}

/**
 * Lists correction rules for the administration page.
 */
function ci_correction_rules_admin_page() {
  $review_labels = ci_correction_rules_review_status_labels();
  $review_filter = isset($_GET['review_status']) && is_string($_GET['review_status'])
    && isset($review_labels[$_GET['review_status']]) ? $_GET['review_status'] : '';
  $query = db_select('node', 'n')
    ->fields('n', array('nid'));
  $query->leftJoin('field_data_field_ci_rule_find', 'f', "f.entity_id = n.nid AND f.entity_type = 'node' AND f.bundle = 'ci_correction_rule' AND f.deleted = 0 AND f.delta = 0");
  if ($review_filter !== '' && field_info_field('field_ci_rule_review_status')) {
    $query->leftJoin('field_data_field_ci_rule_review_status', 'rs', "rs.entity_id = n.nid AND rs.entity_type = 'node' AND rs.bundle = 'ci_correction_rule' AND rs.deleted = 0 AND rs.delta = 0");
    // Rules created before this field existed retain the default Approved state.
    $query->where("COALESCE(NULLIF(rs.field_ci_rule_review_status_value, ''), 'approved') = :ci_review_status", array(':ci_review_status' => $review_filter));
  }
  $query
    ->condition('n.type', 'ci_correction_rule')
    ->orderBy('f.field_ci_rule_find_value', 'ASC')
    ->orderBy('n.nid', 'ASC')
    ->extend('PagerDefault')
    ->limit(50);
  $nids = $query->execute()->fetchCol();
  $nodes = $nids ? node_load_multiple($nids) : array();
  $rows = array();
  $applied_counts = array();

  if (db_table_exists('aa_corrections') && db_field_exists('aa_corrections', 'rule_nid')) {
    $count_query = db_select('aa_corrections', 'c');
    $count_query->fields('c', array('rule_nid'));
    $count_query->addExpression('COUNT(*)', 'record_count');
    $count_query->condition('c.applied', 1);
    $count_query->groupBy('c.rule_nid');
    foreach ($count_query->execute() as $count_row) {
      if (!empty($count_row->rule_nid)) {
        $applied_counts[(int) $count_row->rule_nid] = (int) $count_row->record_count;
      }
    }
  }

  foreach ($nodes as $node) {
    $rule = ci_correction_rules_get_rule($node);
    $operations = array();
    if (ci_correction_rules_manage_access()) {
      $operations[] = l(t('Edit'), 'correction-tools/rules/' . $node->nid . '/edit');
    }
    if (ci_correction_rules_manage_access()) {
      $operations[] = l(t('Delete'), 'correction-tools/rules/' . $node->nid . '/delete');
    }
    $category_labels = array(
      'spelling' => t('Spelling'),
      'capitalization' => t('Capitalization'),
    );
    $match_labels = array(
      'whole_word' => t('Whole word'),
      'part_of_word' => t('Part of word'),
      'prefix' => t('Prefix'),
    );
    $rows[] = array(
      l($rule['title'], 'node/' . (int) $node->nid),
      isset($category_labels[$rule['category']]) ? $category_labels[$rule['category']] : '',
      isset($match_labels[$rule['match_type']]) ? $match_labels[$rule['match_type']] : '',
      isset($review_labels[$rule['review_status']]) ? $review_labels[$rule['review_status']] : '',
      isset($applied_counts[$node->nid]) ? $applied_counts[$node->nid] : 0,
      $node->status ? t('Published') : t('Unpublished'),
      implode(' | ', $operations),
    );
  }

  $build['add'] = array(
    '#markup' => '<p>' . l(t('Review and apply next rule'), 'correction-tools/review') . '</p>'
      . '<p>' . l(t('+ Add a correction rule'), 'correction-tools/rules/add') . '</p>',
  );
  $filter = '<form method="get" action="' . check_url(url('correction-tools/rules')) . '">'
    . '<label for="ci-rule-review-status">' . check_plain(t('Review status')) . '</label> '
    . '<select id="ci-rule-review-status" name="review_status">'
    . '<option value="">' . check_plain(t('All review statuses')) . '</option>';
  foreach ($review_labels as $value => $label) {
    $filter .= '<option value="' . check_plain($value) . '"'
      . ($review_filter === $value ? ' selected="selected"' : '') . '>' . check_plain($label) . '</option>';
  }
  $filter .= '</select> <button type="submit">' . check_plain(t('Filter')) . '</button> '
    . l(t('Clear filters'), 'correction-tools/rules') . '</form>';
  $build['filters'] = array('#markup' => $filter);
  $build['rules'] = array(
    '#theme' => 'table',
    '#header' => array(
      t('Find → Replace with'),
      t('Category'),
      t('Match type'),
      t('Review status'),
      t('Applied changes'),
      t('Status'),
      t('Operations'),
    ),
    '#rows' => $rows,
    '#empty' => t('No correction rules have been created.'),
  );
  $build['pager'] = array('#theme' => 'pager');
  return $build;
}

/**
 * Returns the matching fields of a correction rule node.
 */
function ci_correction_rules_get_rule($node) {
  $rule = array('nid' => $node->nid, 'title' => $node->title);
  $fields = array(
    'category' => 'field_ci_rule_category',
    'old' => 'field_ci_rule_find',
    'new' => 'field_ci_rule_replace',
    'match_type' => 'field_ci_rule_match_type',
    'exceptions' => 'field_ci_rule_exceptions',
    'usage_notes' => 'field_ci_rule_usage_notes',
    'review_status' => 'field_ci_rule_review_status',
  );
  foreach ($fields as $key => $field_name) {
    $items = field_get_items('node', $node, $field_name);
    $rule[$key] = $items ? $items[0]['value'] : '';
  }
  if ($rule['review_status'] === '') {
    $rule['review_status'] = 'approved';
  }
  $display = ci_correction_rules_display_rule($rule);
  $rule['title'] = $display['title'];
  return $rule;
}

/**
 * Returns editorial review labels; publication remains an independent setting.
 */
function ci_correction_rules_review_status_labels() {
  return array(
    'approved' => t('Approved'),
    'needs_review' => t('Needs review'),
    'context_required' => t('Context required'),
  );
}

/**
 * Formats prefix notation for display without changing the matching values.
 */
function ci_correction_rules_display_rule($rule) {
  if (isset($rule['match_type']) && $rule['match_type'] === 'prefix') {
    foreach (array('old', 'new') as $key) {
      if ($rule[$key] !== '' && substr($rule[$key], -1) !== '-') {
        $rule[$key] .= '-';
      }
    }
    $rule['title'] = $rule['old'] . ' → ' . $rule['new'];
  }
  return $rule;
}

/**
 * Implements hook_preprocess_node().
 */
function ci_correction_rules_preprocess_node(&$variables) {
  if ($variables['node']->type === 'ci_correction_rule') {
    $rule = ci_correction_rules_get_rule($variables['node']);
    $variables['title'] = check_plain($rule['title']);
  }
}

/**
 * Creates a stable signature for the current definition of a correction rule.
 *
 * A rejection applies only while the rule has this same definition. Editing
 * the rule therefore makes previously rejected suggestions eligible for
 * review again without deleting their audit records.
 */
function ci_correction_rules_rule_signature($rule) {
  $definition = array(
    'category' => isset($rule['category']) ? (string) $rule['category'] : '',
    'find' => isset($rule['old']) ? (string) $rule['old'] : '',
    'replace' => isset($rule['new']) ? (string) $rule['new'] : '',
    'match_type' => isset($rule['match_type']) ? (string) $rule['match_type'] : '',
    'exceptions' => isset($rule['exceptions']) ? (string) $rule['exceptions'] : '',
  );
  return hash('sha256', serialize($definition));
}

/**
 * Builds the unique key for rejecting one rule match in one chant.
 */
function ci_correction_rules_rejection_hash($nid, $rule, $misspelled_word, $correct_word) {
  $key = array(
    'rule_nid' => isset($rule['nid']) ? (int) $rule['nid'] : 0,
    'nid' => (int) $nid,
    'misspelled_word' => (string) $misspelled_word,
    'correct_word' => (string) $correct_word,
    'rule_signature' => ci_correction_rules_rule_signature($rule),
  );
  return hash('sha256', serialize($key));
}

/**
 * Records that a reviewer rejected one proposed rule match in one chant.
 *
 * This is a chant-specific decision; it does not add a global rule exception.
 */
function ci_correction_rules_record_rejection($nid, $rule, $misspelled_word, $correct_word, $uid = NULL, $timestamp = NULL) {
  global $user;

  $nid = (int) $nid;
  $rule_nid = isset($rule['nid']) ? (int) $rule['nid'] : 0;
  $misspelled_word = trim((string) $misspelled_word);
  $correct_word = trim((string) $correct_word);
  if (!$nid || !$rule_nid || $misspelled_word === '' || !db_table_exists('ci_correction_rule_rejections')) {
    return FALSE;
  }

  $uid = $uid === NULL ? (isset($user->uid) ? (int) $user->uid : 0) : (int) $uid;
  $timestamp = $timestamp === NULL ? REQUEST_TIME : (int) $timestamp;
  $rule_signature = ci_correction_rules_rule_signature($rule);
  $exception_hash = ci_correction_rules_rejection_hash($nid, $rule, $misspelled_word, $correct_word);

  db_merge('ci_correction_rule_rejections')
    ->key(array('exception_hash' => $exception_hash))
    ->insertFields(array(
      'rule_nid' => $rule_nid,
      'nid' => $nid,
      'misspelled_word' => $misspelled_word,
      'correct_word' => $correct_word,
      'rule_signature' => $rule_signature,
      'exception_hash' => $exception_hash,
      'rejected_uid' => $uid,
      'rejected_at' => $timestamp,
    ))
    ->updateFields(array(
      'rejected_uid' => $uid,
      'rejected_at' => $timestamp,
    ))
    ->execute();

  return TRUE;
}

/**
 * Checks whether a reviewer rejected this exact rule match in this chant.
 */
function ci_correction_rules_rejection_exists($nid, $rule, $misspelled_word, $correct_word) {
  if (!db_table_exists('ci_correction_rule_rejections')) {
    return FALSE;
  }

  $exception_hash = ci_correction_rules_rejection_hash($nid, $rule, $misspelled_word, $correct_word);
  return (bool) db_query(
    'SELECT 1 FROM {ci_correction_rule_rejections} WHERE exception_hash = :exception_hash',
    array(':exception_hash' => $exception_hash)
  )->fetchField();
}

/**
 * Removes the reviewer rejection so a suggestion can be reviewed again.
 */
function ci_correction_rules_clear_rejection($nid, $rule, $misspelled_word, $correct_word) {
  if (!db_table_exists('ci_correction_rule_rejections')) {
    return 0;
  }

  $exception_hash = ci_correction_rules_rejection_hash($nid, $rule, $misspelled_word, $correct_word);
  return db_delete('ci_correction_rule_rejections')
    ->condition('exception_hash', $exception_hash)
    ->execute();
}

/**
 * Loads correction rule nodes, ordered by node ID.
 *
 * This function intentionally includes published rules regardless of the
 * current user's node-view permissions so correction workflows can apply the
 * same approved rules consistently. Callers must apply any needed access
 * checks before displaying rule content.
 */
function ci_correction_rules_load($category = NULL, $published_only = TRUE) {
  $query = new EntityFieldQuery();
  $query
    ->entityCondition('entity_type', 'node')
    ->entityCondition('bundle', 'ci_correction_rule')
    ->addTag('DANGEROUS_ACCESS_CHECK_OPT_OUT')
    ->propertyOrderBy('nid', 'ASC');

  if ($published_only) {
    $query->propertyCondition('status', NODE_PUBLISHED);
  }
  if ($category !== NULL) {
    $query->fieldCondition('field_ci_rule_category', 'value', $category);
  }

  $result = $query->execute();
  $nids = !empty($result['node']) ? array_keys($result['node']) : array();
  $nodes = $nids ? node_load_multiple($nids) : array();
  $rules = array();
  foreach ($nodes as $node) {
    $rules[] = ci_correction_rules_get_rule($node);
  }
  return $rules;
}

/**
 * Applies one literal correction rule to one word.
 */
function ci_correction_rules_apply($word, $rule) {
  if (empty($rule['old']) || !isset($rule['match_type'])) {
    return $word;
  }

  $exceptions = isset($rule['exceptions']) ? $rule['exceptions'] : '';
  foreach (preg_split('/\r\n|\r|\n/', $exceptions) as $exception) {
    $exception = trim($exception);
    if ($exception === '') {
      continue;
    }
    $prefix = substr($exception, -1) === '-';
    $literal = $prefix ? substr($exception, 0, -1) : $exception;
    // A lone hyphen is not a prefix and must not exclude every word.
    if ($literal === '') {
      continue;
    }
    $position = mb_stripos($word, $literal, 0, 'UTF-8');
    if (($prefix && $position === 0) || (!$prefix && $position !== FALSE)) {
      return $word;
    }
  }

  $find = preg_quote($rule['old'], '/');
  switch ($rule['match_type']) {
    case 'whole_word':
      $pattern = '/^' . $find . '$/iu';
      break;
    case 'prefix':
      $pattern = '/^' . $find . '/iu';
      break;
    case 'part_of_word':
      $pattern = '/' . $find . '/iu';
      break;
    default:
      return $word;
  }

  $replacement = isset($rule['new']) ? $rule['new'] : '';
  $new_word = preg_replace_callback($pattern, function ($matches) use ($replacement) {
    return $replacement;
  }, $word);

  if ($new_word === NULL || $new_word === $word) {
    return $word;
  }

  if (isset($rule['category']) && $rule['category'] === 'spelling') {
    if ($word === mb_strtoupper($word, 'UTF-8') && $word !== mb_strtolower($word, 'UTF-8')) {
      $new_word = mb_strtoupper($new_word, 'UTF-8');
    }
    elseif (mb_substr($word, 0, 1, 'UTF-8') === mb_strtoupper(mb_substr($word, 0, 1, 'UTF-8'), 'UTF-8')) {
      $new_word = mb_strtoupper(mb_substr($new_word, 0, 1, 'UTF-8'), 'UTF-8')
        . mb_substr($new_word, 1, NULL, 'UTF-8');
    }
  }

  return $new_word;
}
