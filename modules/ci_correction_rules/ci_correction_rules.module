<?php

/**
 * @file
 * Manages spelling and capitalization correction rules as content.
 */

require_once __DIR__ . '/ci_correction_rules.network.inc';
require_once __DIR__ . '/ci_correction_rules.review.inc';

/**
 * Checks access to correction tools for the debra role.
 */
function ci_correction_rules_manage_access($account = NULL) {
  global $user;
  $account = $account ? $account : $user;

  $allowed_roles = array('debra', 'admin', 'administrator');
  foreach (!empty($account->roles) ? $account->roles : array() as $role_name) {
    if (in_array(strtolower(trim((string) $role_name)), $allowed_roles, TRUE)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_menu_alter().
 *
 * Lock down legacy routes while my_corrections remains enabled. New links use
 * the unique correction-tools paths below.
 */
function ci_correction_rules_menu_alter(&$items) {
  $legacy_paths = array(
    'corrections',
    'corrections/network-scan',
    'corrections/network-update',
    'corrections/network-update-run',
    'concordance-spelling',
    'concordance-spelling/%/%',
  );

  foreach ($legacy_paths as $path) {
    if (isset($items[$path])) {
      $items[$path]['access callback'] = 'ci_correction_rules_manage_access';
      unset($items[$path]['access arguments']);
    }
  }
}

