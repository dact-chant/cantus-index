<?php

/**
 * @file
 * Manages spelling and capitalization correction rules as content.
 */

require_once __DIR__ . '/ci_correction_rules.network.inc';
require_once __DIR__ . '/ci_correction_rules.review.inc';

/**
 * Checks access to correction tools for the debra role.
 */
function ci_correction_rules_manage_access($account = NULL) {
  global $user;
  $account = $account ? $account : $user;

  $allowed_roles = array('debra', 'admin', 'administrator');
  foreach (!empty($account->roles) ? $account->roles : array() as $role_name) {
    if (in_array(strtolower(trim((string) $role_name)), $allowed_roles, TRUE)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_menu_alter().
 *
 * Redirect obsolete import and overview pages into the current tools and lock
 * down the remaining legacy routes while my_corrections remains enabled.
 */
function ci_correction_rules_menu_alter(&$items) {
  $legacy_paths = array(
    'corrections',
    'corrections/import',
    'corrections/network-scan',
    'corrections/network-update',
    'corrections/network-update-run',
    'concordance-spelling',
    'concordance-spelling/%/%',
  );

  foreach ($legacy_paths as $path) {
    if (isset($items[$path])) {
      $items[$path]['access callback'] = 'ci_correction_rules_manage_access';
      unset($items[$path]['access arguments']);
    }
  }

  if (isset($items['corrections'])) {
    $items['corrections']['title'] = 'Cantus corrections';
    $items['corrections']['description'] = 'Overview of correction rules, review, history, and concordance tools.';
    $items['corrections']['page callback'] = 'ci_correction_rules_landing_page';
    $items['corrections']['type'] = MENU_NORMAL_ITEM;
    $items['corrections']['menu_name'] = 'main-menu';
  }
  if (isset($items['corrections/import'])) {
    $items['corrections/import']['page callback'] = 'ci_correction_rules_legacy_route_redirect';
  }
  foreach (array('concordance-spelling', 'concordance-spelling/%/%') as $path) {
    if (isset($items[$path])) {
      $items[$path]['page callback'] = 'ci_correction_rules_legacy_route_redirect';
      $items[$path]['type'] = MENU_CALLBACK;
    }
  }
}

/**
 * Redirects an obsolete correction route to its current replacement.
 */
function ci_correction_rules_legacy_route_redirect() {
  $path = current_path();
  if ($path === 'corrections/import') {
    $destination = 'correction-tools/review';
  }
  elseif ($path === 'concordance-spelling') {
    $destination = 'correction-tools/concordance';
  }
  elseif (strpos($path, 'concordance-spelling/') === 0 && arg(1) !== FALSE && arg(2) !== FALSE) {
    $destination = 'correction-tools/concordance/' . arg(1) . '/' . arg(2);
  }
  else {
    $destination = 'correction-tools/history';
  }
  backdrop_goto($destination);
}

