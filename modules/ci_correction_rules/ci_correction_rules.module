<?php

/**
 * @file
 * Manages spelling and capitalization correction rules as content.
 */

require_once __DIR__ . '/ci_correction_rules.network.inc';
require_once __DIR__ . '/ci_correction_rules.review.inc';

/**
 * Implements hook_permission().
 */
function ci_correction_rules_permission() {
  return array(
    'administer ci correction rules' => array(
      'title' => t('Administer CI correction rules'),
      'description' => t('Manage correction rules, review chant matches, apply changes, and view the correction history.'),
    ),
  );
}

/**
 * Checks access to correction review and management pages.
 */
function ci_correction_rules_manage_access($account = NULL) {
  global $user;
  $account = $account ? $account : $user;

  if (user_access('administer ci correction rules', $account) || user_access('administer nodes', $account)) {
    return TRUE;
  }

  // Preserve access previously granted by the legacy my_corrections module.
  $allowed_roles = array('debra', 'administrator', 'admin');
  foreach (!empty($account->roles) ? $account->roles : array() as $role_name) {
    if (in_array(strtolower(trim((string) $role_name)), $allowed_roles, TRUE)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Implements hook_menu().
 */
