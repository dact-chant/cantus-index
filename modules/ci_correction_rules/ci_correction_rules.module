  $items['admin/content/ci-correction-review'] = array(
    'title' => 'Review correction matches',
    'description' => 'Review and apply correction rules to Cantus Index chants.',
    'page callback' => 'ci_correction_rules_review_page',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_LOCAL_TASK,
    'weight' => 21,
  );

  $items['admin/content/ci-correction-audit'] = array(
    'title' => 'Correction history',
    'description' => 'Review correction changes applied to Cantus Index chants.',
    'page callback' => 'ci_correction_rules_audit_page',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_LOCAL_TASK,
    'weight' => 22,
  );

  // Preserve the concordance spelling tools provided by my_corrections.
  $items['corrections'] = array(
    'title' => 'Cantus corrections',
    'page callback' => 'ci_correction_rules_review_page',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['corrections/network-scan'] = array(
    'title' => 'Correction network scan',
    'page callback' => 'ci_correction_rules_network_scan',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_CALLBACK,
  );
  $items['corrections/network-update'] = array(
    'title' => 'Update correction network statistics',
    'page callback' => 'ci_correction_rules_network_update_page',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_CALLBACK,
  );
  $items['corrections/network-update-run'] = array(
    'title' => 'Update correction network statistics - run',
    'page callback' => 'ci_correction_rules_network_update_run',
    'access callback' => 'ci_correction_rules_manage_access',
    'type' => MENU_CALLBACK,
  );
  $items['concordance-spelling'] = array(
    'title' => 'Concordance spelling suggestions',
    'page callback' => 'ci_correction_rules_network_page',
    'access callback' => TRUE,
    'type' => MENU_NORMAL_ITEM,
  );
  $items['concordance-spelling/%/%'] = array(
    'title' => 'Concordance spelling suggestion details',
    'page callback' => 'ci_correction_rules_network_detail_page',
    'page arguments' => array(1, 2),
