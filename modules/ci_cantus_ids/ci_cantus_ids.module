<?php

/**
 * Implements hook_form_alter().
 */
function ci_cantus_ids_form_alter(&$form, &$form_state, $form_id) {

  if ($form_id == 'master_chant_node_form') {

    // Make the Title field non-obligatory.
    $form['title']['#required'] = FALSE;
    $form['title']['#attributes']['placeholder'] =
      t('Cantus ID will be autogenerated if left blank');

    // Check manually entered Cantus IDs.
    $form['#validate'][] = 'ci_cantus_ids_master_chant_validate';


    /*
     * Require Preview before saving.
     */

    // Remove the direct Save button.
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#access'] = FALSE;
    }

    // Preview becomes the main action.
    if (isset($form['actions']['preview'])) {
      $form['actions']['preview']['#value'] = t('Preview and save');
      $form['actions']['preview']['#attributes']['class'][] = 'button-primary';
    }
  }

  if ($form_id == 'suggestion_node_form') {
    $form['#after_build'][] = 'ci_cantus_ids_afterbuild_form_suggestion';
  }
}



function ci_cantus_ids_master_chant_validate($form, &$form_state) {

  $cid = trim($form_state['values']['title']);

  // Empty title is OK - Cantus ID will be autogenerated later.
  if ($cid === '') {
    return;
  }

  // Check whether the manually entered Cantus ID
  // is a currently published historical merged Cantus ID.
  $merged = db_select('aamerged', 'm')
    ->fields('m', array('id', 'new'))
    ->condition('m.old', $cid, '=')
    ->condition('m.published', 1, '=')
    ->range(0, 1)
    ->execute()
    ->fetchObject();

  if ($merged) {
    form_set_error(
      'title',
      t(
        'Cantus ID @old cannot be used. It was previously merged into @new (merge ID @id).',
        array(
          '@old' => $cid,
          '@new' => $merged->new,
          '@id' => $merged->id,
        )
      )
    );
  }
}

/**
 * Alter suggestion form after build.
 */
function ci_cantus_ids_afterbuild_form_suggestion(&$form) {

  $chantnid = arg(3);
  $suggestion_type = arg(4);

  $form['title']['#required'] = FALSE;
  $form['title']['#access'] = FALSE;

  if ($suggestion_type == 'variant') {
    $form['field_suggestion_type']['und'][3314]['#value'] = TRUE;
  }
  else {
    $form['field_suggestion_type']['und'][3313]['#value'] = TRUE;
  }

  if (strlen(arg(3)) > 1) {
    // CHANT IS GIVEN.
    $str = arg(3);
    $node = node_load($str);

    if ($node) {
      $nodetype = $node->type;
      $body = $node->field_full_text['und'][0]['value'];

      if ($nodetype == 'master_chant') {
        $strtitle = $node->title;

        $form['field_full_text']['und'][0]['value']['#value'] = $body;
        $form['field_cantus_id']['und'][0]['target_id']['#value'] = "$strtitle ($str)";
        $form['field_cantus_id']['und'][0]['target_id']['#attributes']['disabled'] = 'disabled';
      }
    }
  }

  return $form;
}


/**
 * Check whether a Cantus ID is unavailable.
 *
 * A Cantus ID is unavailable if:
 * 1. it currently exists as a node title, OR
 * 2. it previously existed and occurs in aamerged.old.
 */
function ci_cantus_ids_id_exists_or_was_merged($cid) {

  $cid = trim($cid);

  if ($cid === '') {
    return FALSE;
  }

  // Does the Cantus ID currently exist as a node title?
  $exists = db_select('node', 'n')
    ->fields('n', array('nid'))
    ->condition('n.title', $cid, '=')
    ->execute()
    ->fetchField();

  if ($exists) {
    return TRUE;
  }

  // Was this Cantus ID used previously and merged?
  $merged = db_select('aamerged', 'm')
    ->fields('m', array('id'))
    ->condition('m.old', $cid, '=')
    ->execute()
    ->fetchField();

  if ($merged) {
    return TRUE;
  }

  return FALSE;
}


/**
 * Implements hook_node_presave().
 */
function ci_cantus_ids_node_presave($node) {

  /*
   * SUGGESTION NODE.
   */
  if ($node->type == 'suggestion') {

    $chantid = $node->field_cantus_id['und'][0]['target_id'];
    $chant = node_load($chantid);

    if ($chant) {
      $node->title = 'Suggestion ' . $chant->title;
    }
  }


  /*
   * MASTER CHANT.
   */
  if ($node->type == 'master_chant') {

    $entity = $node;

    /*
     * Only generate a new Cantus ID if the title is empty.
     */
    if (empty($node->title)) {

      $genre = token_replace(
        '[node:field_genre]',
        array('node' => $entity)
      );

      $mo = '';
      $rite = '';

      /*
       * Load genre information.
       */
      if (!empty($entity->field_genre['und'][0]['target_id'])) {

        $genre_tid = $entity->field_genre['und'][0]['target_id'];
        $genre_term = taxonomy_term_load($genre_tid);

        if ($genre_term) {

          if (!empty($genre_term->field_mass_office['und'][0]['value'])) {
            $mo = $genre_term->field_mass_office['und'][0]['value'];
          }

          if (!empty($genre_term->field_rite['und'][0]['target_id'])) {

            $rite_tid = $genre_term->field_rite['und'][0]['target_id'];
            $rite_term = taxonomy_term_load($rite_tid);

            if ($rite_term) {
              $rite = $rite_term->name;
            }
          }
        }
      }


      /*
       * Get fields used for derived Cantus IDs.
       */
      $relatedID = token_replace(
        '[node:field_related_chant_id]',
        array('node' => $entity),
        array('clear' => TRUE)
      );

      $similarID = token_replace(
        '[node:field_similar_chant_id]',
        array('node' => $entity)
      );

      $tropedID = token_replace(
        '[node:field_troped_chant_id]',
        array('node' => $entity)
      );

      $ftsource = token_replace(
        '[node:field_fulltext_source]',
        array('node' => $entity)
      );

      $lang = token_replace(
        '[node:field_language]',
        array('node' => $entity),
        array('clear' => TRUE)
      );


      $relatedID = trim($relatedID);
      $similarID = trim($similarID);
      $tropedID = trim($tropedID);
      $lang = trim($lang);

      $langWithoutRelated = FALSE;

      dpm($lang);

      /*
       * Base query for aaamcindex.
       */
      $query = db_select('aaamcindex', 'a');


      /*
       * ==========================================================
       * DERIVED CANTUS IDs
       * ==========================================================
       */
      if (
        strlen($relatedID) == 6 ||
        (strlen($similarID) >= 6 && strlen($similarID) < 10) ||
        (strlen($tropedID) >= 6 && strlen($tropedID) < 8) ||
        ($lang != '' && strlen($relatedID) >= 6)
      ) {


        /*
         * ----------------------------------------------------------
         * VARIOUS LANGUAGES WITH RELATED CHANT
         *
         * Example:
         * 001234:cs
         * 001234:cs.1
         * ----------------------------------------------------------
         */
        if ($lang != '') {

          if (strlen($relatedID) >= 6) {

            $newID = $relatedID . ':' . $lang;

            $idExists = ci_cantus_ids_id_exists_or_was_merged($newID);

            if (!$idExists) {
              $node->title = $newID;
            }
            else {

              for ($i = 1; $i <= 999; $i++) {

                $newIDvariant = $newID . '.' . $i;

                $idExists = ci_cantus_ids_id_exists_or_was_merged(
                  $newIDvariant
                );

                if (!$idExists) {
                  $node->title = $newIDvariant;
                  break;
                }
              }
            }
          }
          else {
            $node->title = 'Error: Related ID should have at least 6 characters. Please delete this chant or contact admins.';
          }

          return $node;
        }


        /*
         * ----------------------------------------------------------
         * RELATED CHANT
         *
         * Example:
         * 001234a
         * 001234b
         * 001234aa
         * ----------------------------------------------------------
         */
        dpm($relatedID);

        if (strlen($relatedID) == 6 && $lang == '') {

          if (
            $genre == 'V' ||
            $genre == 'OfV' ||
            $genre == 'AV' ||
            $genre == 'GrV' ||
            $genre == 'CmV' ||
            $genre == 'CmR' ||
            $genre == 'InV' ||
            $genre == 'InR' ||
            $genre == 'AlV' ||
            $genre == 'Tp' ||
            $genre == 'TcV' ||
            $genre == 'ACCV' ||
            $genre == 'LiV' ||
            $genre == 'ALLV' ||
            $genre == 'LDMTV' ||
            $genre == 'SNOV' ||
            $genre == 'BNMTV' ||
            $genre == 'BNSV' ||
            $genre == 'HYMN' ||
            $genre == 'LDMV' ||
            $genre == 'LDOFV' ||
            $genre == 'LDSV' ||
            $genre == 'MSRV' ||
            $genre == 'MTV' ||
            $genre == 'PACV' ||
            $genre == 'PRCSV' ||
            $genre == 'PRLGV' ||
            $genre == 'PSLDV' ||
            $genre == 'PSLMV' ||
            $genre == 'RSV' ||
            $genre == 'SCRV' ||
            $genre == 'SNCTV' ||
            $genre == 'TRNV' ||
            $genre == 'VPRV' ||
            $genre == 'ANTV' ||
            $genre == 'CLMV' ||
            $genre == 'CLMOV' ||
            $genre == 'CFPV' ||
            $genre == 'CaVH' ||
            $genre == 'VARV'
          ) {

            $firstChar = substr($relatedID, 0, 1);

            /*
             * Special rules for non-CAO verses:
             * use z before the automatically generated letter.
             */
            if (
              ($genre == 'V' || $genre == 'AV') &&
              ($firstChar != 'a' && $firstChar != 'g')
            ) {
              $relatedID = $relatedID . 'z';
            }


            /*
             * First try:
             * a, b, c ... z
             *
             * Then:
             * aa, ab ... az, ba, bb ...
             */
            $alphabet1 = array(
              '',
              'a', 'b', 'c', 'd', 'e', 'f', 'g',
              'h', 'i', 'j', 'k', 'l', 'm', 'n',
              'o', 'p', 'q', 'r', 's', 't', 'u',
              'v', 'w', 'x', 'y', 'z'
            );

            $alphabet2 = array(
              'a', 'b', 'c', 'd', 'e', 'f', 'g',
              'h', 'i', 'j', 'k', 'l', 'm', 'n',
              'o', 'p', 'q', 'r', 's', 't', 'u',
              'v', 'w', 'x', 'y', 'z'
            );


            foreach ($alphabet1 as $char1) {

              foreach ($alphabet2 as $char2) {

                dpm($char2);

                $string = $relatedID . $char1 . $char2;

                $newID = preg_replace(
                  '/[^a-zA-Z0-9]+/',
                  '',
                  $string
                );

                $idExists =
                  ci_cantus_ids_id_exists_or_was_merged($newID);

                if (!$idExists) {

                  $finalLetter = $char1 . $char2;

                  $node->title =
                    $relatedID . $finalLetter;

                  return $node;
                }
              }
            }
          }
          else {

            $node->title =
              "Error: Genre $genre is not defined as a related chant. Please delete this chant or contact admins.";
          }
        }


        /*
         * ----------------------------------------------------------
         * SIMILAR CHANT
         *
         * Example:
         * 001234.1
         * 001234a.1
         * ----------------------------------------------------------
         */
        if (
          strlen($similarID) >= 6 &&
          strlen($similarID) < 10
        ) {

          for ($i = 1; $i <= 999; $i++) {

            $newID = $similarID . '.' . $i;

            $idExists =
              ci_cantus_ids_id_exists_or_was_merged($newID);

            if (!$idExists) {

              $node->title = $newID;
              break;
            }
          }
        }
        else {

          $node->title =
            'Error: Similar ID must have between 6 and 9 characters. Please delete this chant or contact admins.';
        }


        /*
         * ----------------------------------------------------------
         * TROPE
         *
         * Example:
         * 001234.Tp1
         * 001234a.Tp2
         * ----------------------------------------------------------
         */
        if (
          strlen($tropedID) >= 6 &&
          strlen($tropedID) < 8
        ) {

          for ($i = 1; $i <= 999; $i++) {

            $newID = $tropedID . '.Tp' . $i;

            $idExists =
              ci_cantus_ids_id_exists_or_was_merged($newID);

            if (!$idExists) {

              $node->title = $newID;
              break;
            }
          }
        }
      }


      /*
       * ==========================================================
       * STANDARD NON-DERIVED CANTUS IDs
       * ==========================================================
       */
      else {

        if ($lang != '') {
          $langWithoutRelated = TRUE;
        }


        /*
         * ----------------------------------------------------------
         * MASS
         * ----------------------------------------------------------
         */
        if ($mo == 'Mass') {


          /*
           * Standard Mass:
           * g00001
           */
          if (!$langWithoutRelated) {

            $query
              ->condition('a.type', 'mass', '=')
              ->fields('a', array('max'));

            $result = $query->execute();

            $max = intval($result->fetchField());

            do {

              $max++;

              $newID =
                'g' .
                str_pad(
                  $max,
                  5,
                  '0',
                  STR_PAD_LEFT
                );

              $idExists =
                ci_cantus_ids_id_exists_or_was_merged($newID);

            } while ($idExists);


            db_update('aaamcindex')
              ->fields(array(
                'max' => $max,
              ))
              ->condition('type', 'mass', '=')
              ->execute();

            $node->title = $newID;
          }


          /*
           * Vernacular Mass.
           *
           * Counter: gx
           * Final title receives :LANG below.
           */
          else {

            $query
              ->condition('a.type', 'gx', '=')
              ->fields('a', array('max'));

            $result = $query->execute();

            $max = intval($result->fetchField());

            do {

              $max++;

              $baseID =
                'gx' .
                str_pad(
                  $max,
                  5,
                  '0',
                  STR_PAD_LEFT
                );

              /*
               * Check the FINAL Cantus ID, including language,
               * because this is what will actually become node.title.
               */
              $newID = $baseID . ':' . $lang;

              $idExists =
                ci_cantus_ids_id_exists_or_was_merged($newID);

            } while ($idExists);


            db_update('aaamcindex')
              ->fields(array(
                'max' => $max,
              ))
              ->condition('type', 'gx', '=')
              ->execute();

            /*
             * Language will be added below.
             */
            $node->title = $baseID;
          }
        }


        /*
         * ----------------------------------------------------------
         * OFFICE
         * ----------------------------------------------------------
         */
        if (
          $mo == 'Office' ||
          $mo == 'Both' ||
          $mo == 'Mass/Office'
        ) {


          /*
           * Standard Office:
           * a00001
           */
          if (!$langWithoutRelated) {

            $query
              ->condition('a.type', 'office', '=')
              ->fields('a', array('max'));

            $result = $query->execute();

            $max = intval($result->fetchField());

            do {

              $max++;

              $newID =
                'a' .
                str_pad(
                  $max,
                  5,
                  '0',
                  STR_PAD_LEFT
                );

              $idExists =
                ci_cantus_ids_id_exists_or_was_merged($newID);

            } while ($idExists);


            db_update('aaamcindex')
              ->fields(array(
                'max' => $max,
              ))
              ->condition('type', 'office', '=')
              ->execute();

            $node->title = $newID;
          }


          /*
           * Vernacular Office.
           *
           * Counter: ax
           * Final title receives :LANG below.
           */
          else {

            $query
              ->condition('a.type', 'ax', '=')
              ->fields('a', array('max'));

            $result = $query->execute();

            $max = intval($result->fetchField());

            do {

              $max++;

              $baseID =
                'ax' .
                str_pad(
                  $max,
                  5,
                  '0',
                  STR_PAD_LEFT
                );

              /*
               * Check the FINAL Cantus ID including language.
               */
              $newID = $baseID . ':' . $lang;

              $idExists =
                ci_cantus_ids_id_exists_or_was_merged($newID);

            } while ($idExists);


            db_update('aaamcindex')
              ->fields(array(
                'max' => $max,
              ))
              ->condition('type', 'ax', '=')
              ->execute();

            /*
             * Language will be added below.
             */
            $node->title = $baseID;
          }
        }


        /*
         * ----------------------------------------------------------
         * HISPANIC
         *
         * Example:
         * h00001
         * ----------------------------------------------------------
         */
        if ($rite == 'Hispanic') {

          $query = db_select('aaamcindex', 'a');

          $query
            ->condition('a.type', 'hispanic', '=')
            ->fields('a', array('max'));

          $result = $query->execute();

          $max = intval($result->fetchField());


          do {

            $max++;

            $baseID =
              'h' .
              str_pad(
                $max,
                5,
                '0',
                STR_PAD_LEFT
              );

            /*
             * If this is a vernacular chant, check the final
             * Cantus ID including :LANG.
             */
            if ($langWithoutRelated) {
              $newID = $baseID . ':' . $lang;
            }
            else {
              $newID = $baseID;
            }

            $idExists =
              ci_cantus_ids_id_exists_or_was_merged($newID);

          } while ($idExists);


          db_update('aaamcindex')
            ->fields(array(
              'max' => $max,
            ))
            ->condition('type', 'hispanic', '=')
            ->execute();

          /*
           * Language, if applicable, is added below.
           */
          $node->title = $baseID;
        }


        /*
         * Add language code to automatically generated
         * vernacular Cantus IDs.
         */
        if ($langWithoutRelated) {

          $node->title =
            $node->title . ':' . $lang;
        }
      }
    }


    /*
     * Final protection against empty autogenerated title.
     */
    if (empty($node->title)) {

      $node->title =
        'Error: Please delete this chant or contact admins';
    }
  }
}