/**
 * Outputs chants that follow the requested CID in concordance sequences.
 */
function ci_json_nextchants($cid) {
  if (ci_json_is_cid_valid($cid)) {
    $sql = "SELECT a.cantus_id, COUNT(*) as follow_count
          FROM aaconcordances_copy a
          JOIN aaconcordances_copy b ON a.siglum = b.siglum AND a.folio = b.folio
          WHERE b.cantus_id = :cid
          AND a.sequence = b.sequence + 1
          AND a.cantus_id IS NOT NULL AND a.cantus_id <> ''
          GROUP BY a.cantus_id
          ORDER BY follow_count DESC";
    $result = db_query($sql, array(':cid' => $cid));
    foreach ($result as $item) {
      $cid = trim($item->cantus_id);
      $arr = array('cid' => $cid, 'count' => $item->follow_count);
      $arr ['info'] = ci_json_nextchant_fields_by_cid($cid);
      $arrs[] = $arr;
    }
  } else {
    $arrs[] = 'Cantus ID is not valid';
  }
  backdrop_json_output($arrs);
  exit;
}

/**
 * Outputs published merge records after the requested ID cursor.
 */
function ci_json_chants_merged() {
  $skip = 0;
  $limit = 10000;

  $params = backdrop_get_query_parameters();

  if (isset($params['skip'])) {
    $skip = max(0, intval($params['skip']));
  }

  if (isset($params['limit'])) {
    $limit = intval($params['limit']);
  }

  $query1 = "
        SELECT id, old, new, date
        FROM {aamerged}
        WHERE id > :skip
          AND published = 1
        ORDER BY id ASC
    ";

  $result1 = db_query_range(
    $query1,
    0,
    $limit,
    array(':skip' => $skip)
  );

  $arrs = array();

  foreach ($result1 as $item) {
    $arrs[] = array(
      'id' => $item->id,
      'old' => $item->old,
      'new' => $item->new,
      'date' => $item->date,
    );
  }

  backdrop_json_output($arrs);
  exit;
}

/**
 * Outputs feast merge records.
 */
function ci_json_feasts_merged() {
  $query1 = "SELECT oldname, newname FROM {aamergedfeasts}";
  $result1 = db_query($query1);
  $arrs = array();
  foreach ($result1 as $item) {
    $arr = array('oldname' => $item->oldname, 'newname' => $item->newname);
    $arrs[] = $arr;
  }
  backdrop_json_output($arrs);
  exit;
}

/**
 * Searches chant texts, preserving legacy wildcard and fallback behavior.
 */
function ci_json_text_search_page() {

  $text = arg(1)."%";
  $text1 = "%".arg(1)."%";

  if (strlen($text1) >= 2) {
    $query = "SELECT b.entity_id AS nid,
                b.field_full_text_value AS ft,
                node.title AS cid,
                term.name AS genre
                FROM field_data_field_full_text b
                INNER JOIN node ON node.nid = b.entity_id
                INNER JOIN field_data_field_genre g ON g.entity_id = b.entity_id
                INNER JOIN taxonomy_term_data term ON term.tid = g.field_genre_target_id
                WHERE b.field_full_text_value LIKE :prefix
                ORDER BY b.field_full_text_value
                LIMIT 0, 100";
    $result = db_query($query, array(':prefix' => $text));
    $arrs = array();
    $i = 0;
    foreach ($result as $item) {
      $i++;
      $fulltext = str_replace("\r\n", '', $item->ft);
      $arr = array('cid' => $item->cid, 'fulltext' => $fulltext, 'genre' => $item->genre);
      $arrs[] = $arr;
    }
    if ($i < 50) {
      $query1 = "SELECT b.entity_id AS nid,
                    b.field_full_text_value AS ft,
                    node.title AS cid,
                    term.name AS genre
                    FROM field_data_field_full_text b
                    INNER JOIN node ON node.nid = b.entity_id
                    INNER JOIN field_data_field_genre g ON g.entity_id = b.entity_id
                    INNER JOIN taxonomy_term_data term ON term.tid = g.field_genre_target_id
                    WHERE b.field_full_text_value LIKE :contains
                    AND b.field_full_text_value NOT LIKE :prefix
                    ORDER BY b.field_full_text_value
                    LIMIT 0, 100";

      $result1 = db_query($query1, array(':contains' => $text1, ':prefix' => $text));
      foreach ($result1 as $item) {
        $i++;
        $fulltext = str_replace("\r\n", '', $item->ft);
        $arr = array('cid' => $item->cid, 'fulltext' => $fulltext, 'genre' => $item->genre);
        $arrs[] = $arr;
      }
    }
    if ($i < 1) {
      $query1 = "SELECT b.entity_id AS nid,
                    b.field_full_text_value AS ft,
                    node.title AS cid,
                    term.name AS genre
                    FROM field_data_field_full_text b
                    INNER JOIN node ON node.nid = b.entity_id
                    INNER JOIN field_data_field_genre g ON g.entity_id = b.entity_id
                    INNER JOIN taxonomy_term_data term ON term.tid = g.field_genre_target_id
                    WHERE node.title LIKE :contains
                    ORDER BY b.field_full_text_value
                    LIMIT 0, 100";

      $result2 = db_query($query1, array(':contains' => $text1));
      foreach ($result2 as $item) {
        $i++;
        $fulltext = str_replace("\r\n", '', $item->ft);
        $arr = array('cid' => $item->cid, 'fulltext' => $fulltext, 'genre' => $item->genre);
        $arrs[] = $arr;
      }
    }

    backdrop_json_output($arrs);
    exit;
  }
}
